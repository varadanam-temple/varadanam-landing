{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "varadanam-landing.vercel.app" }],
      "destination": "https://varadanam.com/$1",
      "permanent": true
    }
  ],
  "rewrites": [{ "source": "/((?!.*\\.(txt|xml|json|svg|png|ico|jpg|jpeg|gif|webp|js|css|woff|woff2|ttf|eot)).*)", "destination": "/index.html" }]
}
